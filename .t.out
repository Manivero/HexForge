241     const root = rootId ? nodes[rootId] : undefined;
242     if (!root) {
243       return false;
244     }
245     set({
246       nodes: { ...nodes, [rootId]: { ...root, params: { sourceHandle } } },
247     });
248     scheduleBackendSync(get());
249     return true;
250   },
251   syncGraphToBackend: async () => {
252     await ipcSetGraph({ nodes: get().nodes });
253   },
