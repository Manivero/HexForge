" #[test]\n    fn single_byte_key_known_vector() {\n        // 0x00..=0x04 XOR 0xFF → ~i\n        let ctx = NullExecutionContext;\n        let out = XorCipher\n            .apply(\n                Cow::Borrowed(&[0x00, 0x01, 0x02]),\n                &serde_json::json!({ \"key\": \"\\u{FF}\" }),\n                &ctx,\n            )\n            .unwrap();\n        assert_eq!(out.as_ref(), &[0xff, 0xfe, 0xfd]);\n    }\n\n    #[test]\n    fn multi_byte_key_cycles() {\n        let"