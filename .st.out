348     #[test]
349     fn output_cache_clear_invalidates_everything() {
350         let mut cache = OutputCache::new(100);
351         cache.put("k".into(), Arc::new(vec![0; 10]));
352         assert!(cache.get("k").is_some());
353 
354         cache.clear();
355         assert!(cache.get("k").is_none(), "после clear старых hit'ов нет");
356         assert_eq!(cache.entries_len(), 0);
357     }
