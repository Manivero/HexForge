# HexForge environment template — copy to .env and adjust locally.
# This file MUST NOT contain real secrets; it is committed as documentation.
# Real .env is ignored via .gitignore:15.

# Optional: override Rust log level for src-tauri or CLI
# RUST_LOG=info

# Optional: Tauri dev server port (must match vite.config.ts:24 and tauri.conf.json:9)
# VITE_PORT=1420

# Optional: custom output cache budget (bytes) for hexforge-engine testing
# HEXFORGE_CACHE_BUDGET=268435456
